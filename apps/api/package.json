{
  "name": "@hajiri/api",
  "version": "0.0.1",
  "private": true,
  "description": "Hajiri core API: Express 5 + PostgreSQL 18. Attendance engine, employee master, devices (Phase 1).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:bs": "tsx src/db/seed-bs-calendar.ts",
    "db:seed:demo": "tsx src/db/seed-demo.ts"
  },
  "dependencies": {
    "@hajiri/attendance-engine": "workspace:*",
    "@hajiri/bs-calendar": "workspace:*",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "5.0.3"
  }
}
