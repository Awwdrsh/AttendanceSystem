# Copy to .env for local development. scripts/setup.sh generates real secrets.
PORT=3000
DATABASE_URL=postgres://localhost:5433/hajiri
DATABASE_URL_TEST=postgres://localhost:5433/hajiri_test
LOG_LEVEL=info
# base64 of 32 random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# any long random string
PASSWORD_PEPPER=
COOKIE_SECURE=false
RUN_WORKER=true
CORS_ORIGINS=http://localhost:5173
