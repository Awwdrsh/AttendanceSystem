PORT=8080
# Omit DATABASE_URL to run with the in-memory store (useful with the simulator).
DATABASE_URL=postgres://localhost:5433/hajiri
LOG_LEVEL=info
# Base64 DER (PKCS#8) Ed25519 private key. Omit in dev to use an ephemeral key (signatures will not verify after restart).
# GATEWAY_SIGNING_KEY=
# Same value as DATA_ENCRYPTION_KEY in apps/api/.env; templates are discarded when absent.
# DATA_ENCRYPTION_KEY=
# Unknown terminals are parked as pending for approval; beyond this many pending rows new ones are refused.
GATEWAY_MAX_PENDING_DEVICES=50
# Punches further in the future than this are flagged clock_skew.
GATEWAY_MAX_CLOCK_SKEW_MIN=10
# Raw request archive (relative to apps/gateway).
GATEWAY_RAW_DIR=data/raw
# CLEAR DATA and firmware commands stay refused unless true. SHELL is always refused.
GATEWAY_ALLOW_DANGEROUS_COMMANDS=false
