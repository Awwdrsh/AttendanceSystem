**/.env.*
**/gateway.env
!**/.env.example
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.hypothesis
**/data
**/logs
**/.run
server/staticfiles
.admin-credentials
.git
infra/pgdata
