# Copy to infra/docker/.env and fill in, then:
#   docker compose -f infra/docker-compose.yml --env-file infra/docker/.env up -d --build
# Generate secrets with:  python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"   (24 for the pepper)
# Moving an existing install? Copy DATA_ENCRYPTION_KEY and PASSWORD_PEPPER (server/.env, or apps/api/.env of the retired
# TypeScript stack) and GATEWAY_SIGNING_KEY (server/gateway.env or apps/gateway/.env) unchanged:
# a different key or pepper makes stored PAN, bank and ID numbers and every existing password unreadable.
POSTGRES_PASSWORD=
DATA_ENCRYPTION_KEY=
PASSWORD_PEPPER=
# Optional: Django's signing key. Left blank, the web app signs with PASSWORD_PEPPER.
DJANGO_SECRET_KEY=
# Base64 DER (PKCS#8) Ed25519 private key:  server/.venv/bin/python scripts/django_ops.py signing-key
GATEWAY_SIGNING_KEY=
# Host names and addresses people use to open the web app, comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
# DEMO loads the demo company; any other code creates that company (with COMPANY_NAME) instead.
COMPANY_CODE=DEMO
COMPANY_NAME=
HAJIRI_ADMIN_EMAIL=
HAJIRI_ADMIN_PASSWORD=
# Background work runs in the `worker` container. For more throughput use the split profile instead (one scheduler,
# any number of task workers):  docker compose ... --profile split up -d --scale worker=0 --scale tasks=3
